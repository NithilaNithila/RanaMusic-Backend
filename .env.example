PORT=5000
MONGO_URI=mongodb://localhost:27017/musicdb

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com)
CLIENT_URL=http://localhost:5173

# Use a long, randomly generated secret (e.g. `openssl rand -hex 64`)
JWT_SECRET=your_jwt_secret_here
# Optional JWT tuning (defaults shown)
# JWT_EXPIRES_IN=7d
# JWT_ISSUER=rana-music
# JWT_AUDIENCE=rana-music-client

SAAVN_API_BASE=https://jiosavanwave.vercel.app/api

# Optional Spotify catalog settings (songs/albums/artists/playlists)
# Free, no-key Spotify data API (same pattern as SAAVN_API_BASE)
SPOTIFY_API_BASE=https://spotify-music-api.onrender.com/api

# Optional YouTube Music catalog settings (songs/albums/artists/playlists/lyrics)
# Free, no-key metadata API (same pattern as SPOTIFY_API_BASE).
YT_API_BASE=https://youtube-music-api-c2p9.onrender.com

# Optional Amazon Music catalog settings (songs/albums/artists/playlists).
# Points to a self-hosted instance of the Amazon Music metadata API:
#   https://github.com/notdeltaxd/Amazon-Music-API
# Run it locally (port 3000) or deploy it, then set the base URL here.
AMAZON_API_BASE=https://amazon-music-api.onrender.com/api

# ── App update / version gate ─────────────────────────────────────────────
# Controls which installed versions can use the API (the "sunset" lever).
#   MIN_APP_VERSION   below this → client shows a blocking force update.
#   LATEST_APP_VERSION behind this → client shows a soft "update available".
# Raise MIN_APP_VERSION over time to retire old builds (e.g. 1.0.0 → 2.0.0).
# MIN_APP_VERSION=1.0.0
# LATEST_APP_VERSION=2.0.0
# APP_UPDATE_MESSAGE=A newer version of RanaMusic is available. Please update to continue.
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.ranamusic.app
# IOS_STORE_URL=https://apps.apple.com/app/id0000000000