PORT=5000
MONGO_URI=mongodb://localhost:27017/musicdb
# TRUST_PROXY=1  # proxy hops behind the app (see src/app.js); false/0 disables

# Comma-separated list of allowed CORS origins (e.g. https://app.example.com)
CLIENT_URL=http://localhost:5173

# Use a long, randomly generated secret (e.g. `openssl rand -hex 64`)
JWT_SECRET=your_jwt_secret_here
# Optional JWT tuning (defaults shown)
# JWT_EXPIRES_IN=7d
# JWT_ISSUER=rana-music
# JWT_AUDIENCE=rana-music-client

SAAVN_API_BASE=https://jiosavanwave.vercel.app/api

# Optional Spotify catalog settings (songs/albums/artists/playlists)
# Free, no-key Spotify data API (same pattern as SAAVN_API_BASE)
SPOTIFY_API_BASE=https://spotify-music-api.onrender.com/api

# Optional Amazon Music catalog + playback settings
# (songs/albums/artists/playlists/playback sessions).
AMAZON_API_BASE=https://amazon-music-api.onrender.com/api

# Optional Amazon Music "web scraper" (unofficial music.amazon.* skill endpoints).
# Catalog + metadata only (no streams — live audio is Widevine DRM), anonymous,
# no LWA approval and no login cookies. Enabled by default; disable to keep the
# backend from ever hitting music.amazon.com skill hosts.
# AMZN_WEB_ENABLED=true
# Which region gets the first shot for by-id album/playlist lookups
# (falls back to all regions regardless). Any of: music.amazon.com, .com.mx,
# .com.br, .ca, .co.uk, .de, .fr, .it, .es, .in, .sa, .ae, .co.jp, .com.au
# AMZN_WEB_REGION_HINT=music.amazon.com

# ── YouTube Music streaming (gap-fill) ────────────────────────────────────
# Ships with yt-dlp (auto-downloaded binary in node_modules). Used only when
# Saavn has no full-length copy, so ~80% of plays never touch YouTube here.
# YT_ENABLED=true
# YTDLP_BINARY=C:\path\to\yt-dlp.exe
# YT_COOKIES=C:\path\to\cookies.txt
# YT_PROXY=http://127.0.0.1:8888
# YT_PLAYER_CLIENT=tv,android  # lock player_client (blank = yt-dlp defaults)
# YT_FORMAT=bestaudio  # default prefers AAC/MP4 (bestaudio[ext=m4a]/bestaudio)
# YT_INFO_TIMEOUT=25000
# YT_STREAM_TIMEOUT=15000
# YT_BREAKER_THRESHOLD=5
# YT_BREAKER_COOLDOWN=60000
# YT_MAX_CONCURRENCY=5  # hard cap on concurrent yt-dlp stream processes

# ── App update / version gate ─────────────────────────────────────────────
# Controls which installed versions can use the API (the "sunset" lever).
#   MIN_APP_VERSION   below this → client shows a blocking force update.
#   LATEST_APP_VERSION behind this → client shows a soft "update available".
# Raise MIN_APP_VERSION over time to retire old builds (e.g. 1.0.0 → 2.0.0).
# MIN_APP_VERSION=1.0.0
# LATEST_APP_VERSION=2.0.0
# APP_UPDATE_MESSAGE=A newer version of RanaMusic is available. Please update to continue.
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.ranamusic.app
# IOS_STORE_URL=https://apps.apple.com/app/id0000000000